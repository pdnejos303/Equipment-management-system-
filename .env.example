# Database (SQLite — local file)
# Production บน Docker จะใช้ /app/data/prod.db (กำหนดใน docker-compose.yml)
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email alerts, optional)
RESEND_API_KEY=""
ALERT_FROM_EMAIL="noreply@yourdomain.com"
ALERT_TO_EMAIL="admin@company.com"

# Cron secret (ใช้ป้องกัน /api/cron/alerts — ตั้งค่าเดียวกับใน Vercel Dashboard)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="Your Company"

# OpenAI (AI features - chat, predictions, suggestions)
OPENAI_API_KEY=""

# ─── Uploads directory ─────────────────────────────────────────────────────
# โฟลเดอร์เก็บรูปอุปกรณ์ (legacy + รูปใหม่)
# - ถ้าไม่ตั้ง: ใช้ ./uploads/ ใน project root (dev บนเครื่องตัวเอง)
# - ใน Docker: docker-compose ตั้ง UPLOADS_DIR=/app/uploads ให้อัตโนมัติ
UPLOADS_DIR=""

# ─── Cloud Photo Storage (optional) ────────────────────────────────────────
# โดย default ระบบเก็บรูปลง local filesystem (public/uploads/) ใช้ได้ทันที
# ถ้าต้องการย้ายไป Supabase Storage (CDN) ค่อยตั้ง 2 ค่านี้ — storage.ts จะ
# auto-switch ให้เอง การตั้ง keys ไม่กระทบกับ database
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="asset-photos"
