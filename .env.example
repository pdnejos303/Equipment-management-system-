# Database (Supabase)
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email alerts, optional)
RESEND_API_KEY=""
ALERT_FROM_EMAIL="noreply@yourdomain.com"
ALERT_TO_EMAIL="admin@company.com"

# Cron secret (ใช้ป้องกัน /api/cron/alerts — ตั้งค่าเดียวกับใน Vercel Dashboard)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="Your Company"

# OpenAI (AI features - chat, predictions, suggestions)
OPENAI_API_KEY=""

# ─── Supabase Storage (รูปอุปกรณ์) ─────────────────────────────────────────
# ถ้าตั้งครบ 2 ค่านี้ → storage.ts จะ auto-switch ไปใช้ Supabase Storage
# ไม่ตั้ง → ใช้ local filesystem (public/uploads/) เหมือนเดิม
# วิธีหา keys: Supabase Dashboard → Project Settings → API
# วิธีตั้ง bucket: Dashboard → Storage → New bucket ชื่อ "asset-photos" (เปิด public)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="asset-photos"
