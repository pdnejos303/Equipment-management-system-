# คัดลอกไฟล์นี้เป็น .env.production บนเครื่อง server แล้วแก้ค่าตามจริง
# docker compose จะอ่านไฟล์ที่ชื่อ .env (ไม่ใช่ .env.production)
# วิธีใช้: cp .env.production.example .env แล้วแก้ค่า แล้ว `docker compose up -d`

# ── URL ของ server (สำคัญ!) ──
# ใส่ IP หรือโดเมนที่จะใช้เข้าเว็บ + port
# ตัวอย่าง: http://192.168.1.50:3000  หรือ  https://equiptrack.company.com
NEXTAUTH_URL=http://YOUR-SERVER-IP:3000
NEXT_PUBLIC_APP_URL=http://YOUR-SERVER-IP:3000

# ── NextAuth secret (สุ่มใหม่!) ──
# สร้างด้วย: openssl rand -base64 32   (หรือใน PowerShell: [Convert]::ToBase64String((1..32 | %{[byte](Get-Random -Max 256)})))
NEXTAUTH_SECRET=CHANGE-ME-TO-LONG-RANDOM-STRING

# ── ชื่อบริษัท ──
NEXT_PUBLIC_COMPANY_NAME=Asset Management

# ── Google OAuth (ทิ้งว่างถ้าไม่ใช้) ──
# ⚠️ ถ้าใช้ ต้องเข้า Google Cloud Console เพิ่ม Authorized redirect URI:
#    http://YOUR-SERVER-IP:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email alerts (Resend) ──
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=

# ── Cron secret ──
CRON_SECRET=CHANGE-ME

# ── OpenAI (AI features) ──
OPENAI_API_KEY=
